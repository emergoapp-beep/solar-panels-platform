NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necessaria per il cron dei ricavi pannelli (/api/cron/accrue-panels)
# e per il tracciamento delle visite (/api/track).
# Da Supabase: Project Settings -> API -> service_role key.
# NON è la anon key, va tenuta segreta, mai esposta al client.
SUPABASE_SERVICE_ROLE_KEY=

# Stringa a caso generata da te, usata per proteggere l'endpoint del cron.
CRON_SECRET=
